# IP вашего Mac в локальной сети (найти: System Settings → Wi-Fi → Details)
# Используется в dev-режиме, если не задан app.json extra.apiUrl
LOCAL_IP=192.168.1.100

# API (можно переопределить в .env)
EXPO_PUBLIC_API_URL=https://quicky-api.onrender.com

# Google OAuth (https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs)
# Тип "iOS" → вставить в IOS_CLIENT_ID
# Тип "Android" → вставить в ANDROID_CLIENT_ID
# Тип "Web application" → вставить в WEB_CLIENT_ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com
