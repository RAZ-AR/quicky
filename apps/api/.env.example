# ─── База данных ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://quicky:quicky@localhost:5432/quicky

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Аутентификация ──────────────────────────────────────────────────────────
JWT_SECRET=change-this-in-production-to-a-long-random-string

# ─── Сервер ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# URL сервера (для ссылок на загруженные файлы; укажите IP вашей машины в LAN)
BASE_URL=http://192.168.1.100:3000

# ─── Загрузка файлов ─────────────────────────────────────────────────────────
# UPLOAD_DIR=./uploads

# ─── AI Провайдер ─────────────────────────────────────────────────────────────
# Варианты: mock | groq | ollama | openai

# Локальная разработка (бесплатно):
AI_PROVIDER=mock

# Тестирование с реальным AI (бесплатный тариф Groq):
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...

# Полностью локально через Ollama ($ ollama pull llama3.2):
# AI_PROVIDER=ollama

# Продакшн:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ─── Фоновые задачи (BullMQ) ─────────────────────────────────────────────────
# ENABLE_JOBS=true

# ─── Social Auth ─────────────────────────────────────────────────────────────
# Google OAuth (https://console.cloud.google.com)
GOOGLE_IOS_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com

# Apple Sign In (com.quicky.app — bundle ID)
APPLE_BUNDLE_ID=com.quicky.app

# Telegram Bot (https://t.me/BotFather → /newbot)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_BOT_NAME=QuickyAuthBot

# Публичный URL API (для redirect виджета Telegram)
API_BASE_URL=https://quicky-api.onrender.com
